[Unit]
Description=MaxCamera Web: web gateway (no network interfaces)
After=maxcamera-control-bridge.service
PartOf=maxcamera-control.target

[Service]
EnvironmentFile=-%h/MaxCameraApp/deploy/maxcamera.env
ExecStart=%h/MaxCameraApp/deploy/sandbox-run.sh web
Restart=always
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=yes
MemoryMax=2G

[Install]
WantedBy=maxcamera-control.target
